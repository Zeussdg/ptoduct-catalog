# Product Catalog'un KENDİ MySQL veritabanı (Prisma bu URL'i kullanır)
DATABASE_URL="mysql://user:password@localhost:3306/urun_katalog"

# Sunucu
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN="http://localhost:5173"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"

# S3-uyumlu object storage (AWS S3 / MinIO / Cloudflare R2 / Backblaze B2 / DO Spaces)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="urun-katalog-images"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL_BASE=""
S3_FORCE_PATH_STYLE="true"

# ==================================================================
# EXTERNAL CUSTOMER DATABASE — şu an UNKNOWN / TBD (bkz. plan §6)
# Gerçek bağlantı bilgisi geldiğinde doldurulacak. Boş bırakıldığı
# sürece sistem MockExternalCustomerAdapter kullanır.
# Database engine, tablo/kolon adları dahil hiçbir şey netleşmedi.
# ==================================================================
EXTERNAL_DB_HOST=""
EXTERNAL_DB_PORT=""
EXTERNAL_DB_NAME=""
EXTERNAL_DB_USER=""
EXTERNAL_DB_PASSWORD=""
