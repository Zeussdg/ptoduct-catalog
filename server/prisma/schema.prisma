// Product Catalog'un KENDİ veritabanı şeması.
// Harici müşteri veritabanı ile hiçbir ilişkisi yoktur (bkz. ExternalIdentity
// modelinin altındaki not ve /server/src/services/externalCustomer/README.md).

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum QuoteStatus {
  PENDING
  REVIEWING
  OFFERED
  ACCEPTED
  REJECTED
  CANCELLED
}

enum Currency {
  TRY
  USD
  EUR
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  username     String?    @unique
  // Nullable: harici kaynaktan onboard edilip henüz yerel şifresi
  // belirlenmemiş kullanıcılar için (bkz. ExternalIdentity notu).
  passwordHash String?    @map("password_hash")
  role         Role       @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  companyName  String?    @map("company_name")
  name         String?
  surname      String?
  phone        String?
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  cart               Cart?
  quotes             Quote[]
  sessions           Session[]
  auditLogs          AuditLog[]         @relation("AuditLogActor")
  customerPrices     CustomerPrice[]
  externalIdentities ExternalIdentity[]

  @@map("users")
}

// Bir kullanıcının harici bir kaynak sistemdeki kimliğine gevşek (loosely-coupled)
// bağı. Ayrı bir tablo olmasının sebebi: external ID'nin gerçek tipi
// (integer/UUID/string), kaynağın sayısı (ileride birden fazla harici sistem
// olabilir) ve bu ilişkinin nasıl kurulacağı henüz belirlenmedi (discovery
// aşaması tamamlanmadı — bkz. server/src/services/externalCustomer/README.md).
// externalId şimdilik String olarak modellendi: en esnek/kayıpsız seçenek,
// gerçek kaynakta ID tipi integer olsa bile string'e güvenle sığar.
model ExternalIdentity {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  source     String // kaynak sistemin adı, örn. "legacy-erp" — TBD
  externalId String   @map("external_id") @db.VarChar(191)
  metadata   Json? // discovery sonrası ham/ek alanlar için esnek alan
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
  @@index([userId])
  @@map("external_identities")
}

model Session {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  refreshToken String    @unique @map("refresh_token") // SHA-256 hash, ham değer değil
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address")
  rememberMe   Boolean   @default(false) @map("remember_me")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  parentId  Int?     @map("parent_id")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryChildren")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id            Int      @id @default(autoincrement())
  brand         String?
  name          String
  stockCode     String   @unique @map("stock_code")
  categoryId    Int?     @map("category_id")
  description   String?  @db.Text
  price         Decimal  @db.Decimal(12, 2)
  discountPrice Decimal? @map("discount_price") @db.Decimal(12, 2)
  currency      Currency @default(TRY)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images         ProductImage[]
  cartItems      CartItem[]
  quoteItems     QuoteItem[]
  customerPrices CustomerPrice[]

  @@index([categoryId])
  @@index([isActive])
  @@map("products")
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  key       String // S3 object key
  url       String   @db.Text
  isPrimary Boolean  @default(false) @map("is_primary")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// Ana sayfadaki kampanya slider'ının (CampaignSlider) arka plan görselleri.
// Kampanya metin/link/renk bilgisi frontend'de sabit (src/data/campaigns.js);
// burada yalnızca kampanya başına yüklenen görsel tutulur. campaignId statik
// kampanya id'sidir (örn. "ups-guardian") ve benzersizdir: her kampanyada en
// fazla bir banner görseli olur (upsert mantığı).
model CampaignBanner {
  id         Int      @id @default(autoincrement())
  campaignId String   @unique @map("campaign_id")
  key        String // S3 object key
  url        String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("campaign_banners")
}

model PriceList {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  customerPrices CustomerPrice[]

  @@map("price_lists")
}

model CustomerPrice {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  productId   Int       @map("product_id")
  priceListId Int?      @map("price_list_id")
  price       Decimal   @db.Decimal(12, 2)
  currency    Currency  @default(TRY)
  validFrom   DateTime? @map("valid_from")
  validTo     DateTime? @map("valid_to")
  createdAt   DateTime  @default(now()) @map("created_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceList PriceList? @relation(fields: [priceListId], references: [id], onDelete: SetNull)

  @@unique([userId, productId])
  @@map("customer_prices")
}

model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int      @map("cart_id")
  productId Int      @map("product_id")
  qty       Int      @default(1)
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2) // snapshot — eklenme anındaki fiyat
  currency  Currency @map("currency")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Quote {
  id        Int         @id @default(autoincrement())
  userId    Int         @map("user_id")
  status    QuoteStatus @default(PENDING)
  note      String?     @db.Text
  adminNote String?     @map("admin_note") @db.Text
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items QuoteItem[]

  @@index([userId])
  @@index([status])
  @@map("quotes")
}

model QuoteItem {
  id          Int      @id @default(autoincrement())
  quoteId     Int      @map("quote_id")
  productId   Int?     @map("product_id") // ürün silinse bile teklif kaydı kalır
  productName String   @map("product_name") // snapshot
  productCode String   @map("product_code") // snapshot
  qty         Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2) // snapshot
  totalPrice  Decimal  @map("total_price") @db.Decimal(12, 2) // snapshot
  currency    Currency @map("currency")
  createdAt   DateTime @default(now()) @map("created_at")

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@map("quote_items")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?     @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@map("audit_logs")
}
